# Generated manifests (regenerated by gen_book_manifest.js, not source of truth)
books/*/_manifest.json

# Temp / verification artifacts
.deploy_verify/
.qa-deps/
.qa-labs/
.art-review/
*.tmp

# Hotspot recalibration working set (dump_hotspots.js -> gen_calib_images.py).
# ~200MB of annotated rulers; regenerate locally, never commit.
calib/

# PWA offline-test screenshots
preview_pwa/

# Dependencies (managed runtimes keep these outside the repo)
node_modules/
.learnings/

# Python bytecode (qa_pwa.py imports tools/*.py, which writes these)
__pycache__/
*.pyc

# EdgeOne Pages CLI artifacts (build cache / local config, never commit)
.edgeone/
.env

# Schoolbus narration: WAV are local lossless masters, NOT the deliverable.
# The committed audio is the 192kbps MP3 set (regenerate WAVs with
# `python gen_schoolbus_voiceover.py --run`, then `--mp3` to transcode).
books/schoolbus/audio/narration/*.wav
books/schoolbus/audio/narration/_pending.json

# Isolated feature worktrees
.worktrees/

# Earthquake narration masters and local voice references stay on this machine.
# The release includes formal MP3s/manifests and the redacted per-file validation report.
workbench/earthquake-audio-v1/*
!workbench/earthquake-audio-v1/batch-validation.json

# Earthquake v2 narration masters and local voice references stay on this machine.
# Only the redacted per-file validation report is eligible for review/collection.
workbench/earthquake-audio-v2/*
!workbench/earthquake-audio-v2/batch-validation.json

# Byte-exact large film payloads are pinned in same-repository Release assets.
# Hydrate them with tools/release_assets.mjs; never stage >100 MiB blobs.
animations/ropeway-adventure/media/browser-v5.mp4
animations/ropeway-adventure/downloads/ropeway-v5.mp4
animations/ropeway-adventure/downloads/ropeway-v5.html
animations/ropeway-adventure/downloads/ropeway-v5-project-offline-v3.html
