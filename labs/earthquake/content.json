{
  "contentVersion": "earthquake-lab-v1",
  "entries": [
    { "id": "lab-title", "kind": "knowledge", "conceptId": "fault", "zh": "地面为什么会摇？", "en": "Why does the ground shake?", "narrationNeeded": true, "contentVersion": "earthquake-lab-v1" },
    { "id": "lab-subtitle", "kind": "knowledge", "conceptId": "fault", "zh": "转一转岩层，找出藏在地下的线索。", "en": "Turn the rock block and look for clues underground.", "narrationNeeded": true, "contentVersion": "earthquake-lab-v1" },
    { "id": "card-elastic-rebound", "kind": "prompt", "conceptId": "elastic-strain", "zh": "1 · 岩石先弯，再错开", "en": "1 · Bend, then slip", "narrationNeeded": true, "contentVersion": "earthquake-lab-v1" },
    { "id": "card-fault-types", "kind": "prompt", "conceptId": "fault", "zh": "2 · 三种断层", "en": "2 · Three fault motions", "narrationNeeded": true, "contentVersion": "earthquake-lab-v1" },
    { "id": "card-focus-epicenter", "kind": "prompt", "conceptId": "focus", "zh": "3 · 地下起点", "en": "3 · The underground start", "narrationNeeded": true, "contentVersion": "earthquake-lab-v1" },
    { "id": "card-waves", "kind": "prompt", "conceptId": "wavefront", "zh": "4 · 波往外走", "en": "4 · Waves travel outward", "narrationNeeded": true, "contentVersion": "earthquake-lab-v1" },
    { "id": "question-elastic-rebound", "kind": "prompt", "conceptId": "elastic-strain", "zh": "接缝还没动，旁边的岩石怎样了？", "en": "What happens beside the seam before it slips?", "narrationNeeded": true, "contentVersion": "earthquake-lab-v1" },
    { "id": "question-fault-types", "kind": "prompt", "conceptId": "fault", "zh": "两边沿接缝怎样错开？", "en": "How do the two sides move along the seam?", "narrationNeeded": true, "contentVersion": "earthquake-lab-v1" },
    { "id": "question-focus-epicenter", "kind": "prompt", "conceptId": "epicenter", "zh": "地下从哪儿开始？它正上方在哪儿？", "en": "Where does it start below ground, and what is directly above?", "narrationNeeded": true, "contentVersion": "earthquake-lab-v1" },
    { "id": "question-waves", "kind": "prompt", "conceptId": "particle-motion", "zh": "往外走的是振动，还是这颗石头？", "en": "Does the disturbance travel, or does this rock travel with it?", "narrationNeeded": true, "contentVersion": "earthquake-lab-v1" },
    { "id": "result-initial", "kind": "result", "conceptId": "fault", "zh": "先看横跨接缝的深色标记线。", "en": "First, find the dark line crossing the seam.", "narrationNeeded": true, "contentVersion": "earthquake-lab-v1" },
    { "id": "result-locked", "kind": "result", "conceptId": "elastic-strain", "zh": "接缝暂时卡住，旁边却正在变形。", "en": "The seam is locked, but nearby rock is changing shape.", "narrationNeeded": true, "contentVersion": "earthquake-lab-v1" },
    { "id": "result-slipped", "kind": "result", "conceptId": "slip", "zh": "突然滑动了！弯曲回弹了一部分，标记线仍然错开。", "en": "It slipped! Some bending rebounds, but the marker stays offset.", "narrationNeeded": true, "contentVersion": "earthquake-lab-v1" },
    { "id": "result-settled", "kind": "result", "conceptId": "slip", "zh": "安静下来后，永久错位没有消失。", "en": "After the motion settles, the lasting offset remains.", "narrationNeeded": true, "contentVersion": "earthquake-lab-v1" },
    { "id": "result-fault-types", "kind": "result", "conceptId": "fault", "zh": "比较的是两块岩石的相对方向，不是地震强弱。", "en": "Compare relative directions, not earthquake strength.", "narrationNeeded": true, "contentVersion": "earthquake-lab-v1" },
    { "id": "result-focus-hint", "kind": "result", "conceptId": "focus", "zh": "从地下红点沿竖直方向往上找。", "en": "Look straight up from the red point underground.", "narrationNeeded": true, "contentVersion": "earthquake-lab-v1" },
    { "id": "result-focus-correct", "kind": "result", "conceptId": "epicenter", "zh": "找到了！地下起点是震源，正上方的地表点是震中。", "en": "You found it! The underground start is the focus; its surface point is the epicenter.", "narrationNeeded": true, "contentVersion": "earthquake-lab-v1" },
    { "id": "result-waves", "kind": "result", "conceptId": "particle-motion", "zh": "波前往外走，黄点只在原来的位置附近往复。", "en": "The wavefront travels outward; the yellow point moves only around its own spot.", "narrationNeeded": true, "contentVersion": "earthquake-lab-v1" },
    { "id": "result-arrival", "kind": "result", "conceptId": "wavefront", "zh": "近旗先收到同一种波；同一面旗上 P 波先于 S 波。", "en": "The near flag receives the same wave first; P reaches one flag before S.", "narrationNeeded": true, "contentVersion": "earthquake-lab-v1" },
    { "id": "toy-caveat", "kind": "knowledge", "conceptId": "fault", "zh": "这是放大动作的教学模型，不是地震倒计时，也不能预测真实地震。", "en": "This teaching model exaggerates motion. It is not a countdown and cannot predict a real earthquake.", "narrationNeeded": false, "contentVersion": "earthquake-lab-v1" },
    { "id": "wave-caveat", "kind": "knowledge", "conceptId": "wavefront", "zh": "波卡把岩层简化成均匀介质；两面旗不能唯一确定震中。", "en": "The wave card uses a uniform medium. Two flags cannot uniquely locate an epicenter.", "narrationNeeded": false, "contentVersion": "earthquake-lab-v1" },
    { "id": "surface", "kind": "knowledge", "conceptId": "fault", "zh": "地表", "en": "Surface", "narrationNeeded": false, "contentVersion": "earthquake-lab-v1" },
    { "id": "footwall", "kind": "knowledge", "conceptId": "fault", "zh": "下盘岩体", "en": "Footwall rock", "narrationNeeded": false, "contentVersion": "earthquake-lab-v1" },
    { "id": "hanging-wall", "kind": "knowledge", "conceptId": "fault-reverse", "zh": "上盘岩体", "en": "Hanging-wall rock", "narrationNeeded": false, "contentVersion": "earthquake-lab-v1" },
    { "id": "fault-plane", "kind": "knowledge", "conceptId": "fault", "zh": "倾斜断层面", "en": "Dipping fault plane", "narrationNeeded": true, "contentVersion": "earthquake-lab-v1" },
    { "id": "marker-line", "kind": "knowledge", "conceptId": "slip", "zh": "跨断层标记线", "en": "Marker across the fault", "narrationNeeded": true, "contentVersion": "earthquake-lab-v1" },
    { "id": "focus", "kind": "knowledge", "conceptId": "focus", "zh": "震源：地下起裂点", "en": "Focus: underground rupture start", "narrationNeeded": true, "contentVersion": "earthquake-lab-v1" },
    { "id": "epicenter", "kind": "knowledge", "conceptId": "epicenter", "zh": "震中：震源正上方的地表点", "en": "Epicenter: the surface point above the focus", "narrationNeeded": true, "contentVersion": "earthquake-lab-v1" },
    { "id": "near-flag", "kind": "knowledge", "conceptId": "wavefront", "zh": "近旗 A", "en": "Near flag A", "narrationNeeded": false, "contentVersion": "earthquake-lab-v1" },
    { "id": "far-flag", "kind": "knowledge", "conceptId": "wavefront", "zh": "远旗 B", "en": "Far flag B", "narrationNeeded": false, "contentVersion": "earthquake-lab-v1" },
    { "id": "wavefront", "kind": "knowledge", "conceptId": "wavefront", "zh": "向外传播的波前", "en": "Outward travelling wavefront", "narrationNeeded": true, "contentVersion": "earthquake-lab-v1" },
    { "id": "particle", "kind": "knowledge", "conceptId": "particle-motion", "zh": "只在原处附近往复的黄点", "en": "Yellow point moving around a fixed spot", "narrationNeeded": true, "contentVersion": "earthquake-lab-v1" },
    { "id": "fault-locked", "kind": "knowledge", "conceptId": "elastic-strain", "zh": "局部锁定区", "en": "Local locked patch", "narrationNeeded": false, "contentVersion": "earthquake-lab-v1" },
    { "id": "fault-dip", "kind": "knowledge", "conceptId": "fault", "zh": "断层面向右下方倾斜", "en": "The fault dips down to the right", "narrationNeeded": false, "contentVersion": "earthquake-lab-v1" },
    { "id": "strata-bend", "kind": "knowledge", "conceptId": "elastic-strain", "zh": "标记线记录先弯后错", "en": "The marker records bending then offset", "narrationNeeded": false, "contentVersion": "earthquake-lab-v1" },
    { "id": "focus-depth", "kind": "knowledge", "conceptId": "focus", "zh": "固定的地下起点", "en": "The fixed underground start", "narrationNeeded": false, "contentVersion": "earthquake-lab-v1" },
    { "id": "epicenter-projection", "kind": "knowledge", "conceptId": "epicenter", "zh": "向地表的竖直投影", "en": "Vertical projection to the surface", "narrationNeeded": false, "contentVersion": "earthquake-lab-v1" },
    { "id": "flag-distance", "kind": "knowledge", "conceptId": "wavefront", "zh": "离震源更远的旗", "en": "The flag farther from the focus", "narrationNeeded": false, "contentVersion": "earthquake-lab-v1" },
    { "id": "p-front", "kind": "knowledge", "conceptId": "p-wave", "zh": "传播较快的 P 波", "en": "The faster P wave", "narrationNeeded": false, "contentVersion": "earthquake-lab-v1" },
    { "id": "particle-origin", "kind": "knowledge", "conceptId": "particle-motion", "zh": "黄点的原来位置", "en": "The yellow point's original spot", "narrationNeeded": false, "contentVersion": "earthquake-lab-v1" },
    { "id": "back-book", "kind": "knowledge", "conceptId": "fault", "zh": "返回绘本", "en": "Back to the book", "narrationNeeded": false, "contentVersion": "earthquake-lab-v1" },
    { "id": "drive", "kind": "prompt", "conceptId": "elastic-strain", "zh": "按住慢慢推动", "en": "Hold to push slowly", "narrationNeeded": false, "contentVersion": "earthquake-lab-v1" },
    { "id": "step", "kind": "prompt", "conceptId": "elastic-strain", "zh": "推一小步", "en": "Push one step", "narrationNeeded": false, "contentVersion": "earthquake-lab-v1" },
    { "id": "pause", "kind": "prompt", "conceptId": "elastic-strain", "zh": "暂停", "en": "Pause", "narrationNeeded": false, "contentVersion": "earthquake-lab-v1" },
    { "id": "resume", "kind": "prompt", "conceptId": "elastic-strain", "zh": "继续", "en": "Resume", "narrationNeeded": false, "contentVersion": "earthquake-lab-v1" },
    { "id": "replay", "kind": "prompt", "conceptId": "slip", "zh": "慢放刚才的过程", "en": "Replay the same steps slowly", "narrationNeeded": false, "contentVersion": "earthquake-lab-v1" },
    { "id": "reset", "kind": "prompt", "conceptId": "fault", "zh": "重新开始", "en": "Start again", "narrationNeeded": false, "contentVersion": "earthquake-lab-v1" },
    { "id": "wave-play", "kind": "prompt", "conceptId": "wavefront", "zh": "播放并追踪黄点", "en": "Play and track the yellow point", "narrationNeeded": false, "contentVersion": "earthquake-lab-v1" },
    { "id": "wave-step", "kind": "prompt", "conceptId": "wavefront", "zh": "波走一小步", "en": "Advance the wave one step", "narrationNeeded": false, "contentVersion": "earthquake-lab-v1" },
    { "id": "cutaway", "kind": "prompt", "conceptId": "focus", "zh": "剖开 / 合上", "en": "Cut away / restore", "narrationNeeded": false, "contentVersion": "earthquake-lab-v1" },
    { "id": "view-side", "kind": "prompt", "conceptId": "fault", "zh": "侧面", "en": "Side", "narrationNeeded": false, "contentVersion": "earthquake-lab-v1" },
    { "id": "view-top", "kind": "prompt", "conceptId": "fault-strike-slip", "zh": "俯视", "en": "Top", "narrationNeeded": false, "contentVersion": "earthquake-lab-v1" },
    { "id": "view-reset", "kind": "prompt", "conceptId": "fault", "zh": "初始视角", "en": "Home view", "narrationNeeded": false, "contentVersion": "earthquake-lab-v1" },
    { "id": "zoom-in", "kind": "prompt", "conceptId": "fault", "zh": "放大 ＋", "en": "Zoom in +", "narrationNeeded": false, "contentVersion": "earthquake-lab-v1" },
    { "id": "zoom-out", "kind": "prompt", "conceptId": "fault", "zh": "缩小 −", "en": "Zoom out -", "narrationNeeded": false, "contentVersion": "earthquake-lab-v1" },
    { "id": "type-normal", "kind": "prompt", "conceptId": "fault-normal", "zh": "正断层 · 上盘下移", "en": "Normal · hanging wall down", "narrationNeeded": false, "contentVersion": "earthquake-lab-v1" },
    { "id": "type-reverse", "kind": "prompt", "conceptId": "fault-reverse", "zh": "逆断层 · 上盘上移", "en": "Reverse · hanging wall up", "narrationNeeded": false, "contentVersion": "earthquake-lab-v1" },
    { "id": "type-strike-slip", "kind": "prompt", "conceptId": "fault-strike-slip", "zh": "走滑断层 · 水平错开", "en": "Strike-slip · sideways", "narrationNeeded": false, "contentVersion": "earthquake-lab-v1" },
    { "id": "guess-left", "kind": "prompt", "conceptId": "epicenter", "zh": "地表 A", "en": "Surface A", "narrationNeeded": false, "contentVersion": "earthquake-lab-v1" },
    { "id": "guess-correct", "kind": "prompt", "conceptId": "epicenter", "zh": "地表 B", "en": "Surface B", "narrationNeeded": false, "contentVersion": "earthquake-lab-v1" },
    { "id": "guess-right", "kind": "prompt", "conceptId": "epicenter", "zh": "地表 C", "en": "Surface C", "narrationNeeded": false, "contentVersion": "earthquake-lab-v1" },
    { "id": "wave-combined", "kind": "prompt", "conceptId": "wavefront", "zh": "一起看", "en": "Together", "narrationNeeded": false, "contentVersion": "earthquake-lab-v1" },
    { "id": "wave-p", "kind": "prompt", "conceptId": "p-wave", "zh": "只看 P", "en": "P only", "narrationNeeded": false, "contentVersion": "earthquake-lab-v1" },
    { "id": "wave-s", "kind": "prompt", "conceptId": "s-wave", "zh": "只看 S", "en": "S only", "narrationNeeded": false, "contentVersion": "earthquake-lab-v1" },
    { "id": "listen", "kind": "prompt", "conceptId": "fault", "zh": "听这一句", "en": "Listen to this line", "narrationNeeded": false, "contentVersion": "earthquake-lab-v1" },
